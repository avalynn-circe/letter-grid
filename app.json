{
  "expo": {
    "name": "LoFi Letter Grid",
    "slug": "lofi-letter-grid",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF3FC",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.avalynncirce.lofilettergrid"
    },
    "android": {
      "package": "com.avalynncirce.lofilettergrid",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4568D6"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 330,
          "backgroundColor": "#EEF3FC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a4f3ca67-4465-4006-b55a-be5a8da07360"
      }
    }
  }
}
